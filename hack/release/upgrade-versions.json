    "version": "v6.1.3-release",
    "detail": {
      "update_time": "2025-03-13",
      "html_url": "https://github.com/goodrain/rainbond/releases/tag/v6.1.3-release",
      "tag_name": "v6.1.3-release",
      "body": "## What's Changes\r\n+ Fixed an issue where shared storage from other components was not displayed in component sharing. #2160.\r\n+ Fixed the inability to save gateway routes containing uppercase/lowercase and special characters when adding them. #2154\r\n+ Added domain name validation rules for gateway additions.\r\n+ Fixed an issue with pagination display in certificate management.\r\n+ Fixed issues related to Helm.\r\n+ Fixed a memory leak in rbd-api."
    },
    "images": {
      "rbd-api": "registry.cn-hangzhou.aliyuncs.com/goodrain/rbd-api:v6.1.3-release",
